<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đánh giá của bạn"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp"/>

    <RatingBar
        android:id="@+id/rating_input_bar"

        style="?android:attr/ratingBarStyle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="0.5"
        android:rating="5.0"
        android:progressTint="@color/star_filled"
        android:progressBackgroundTint="@color/star_empty"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/et_review_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Viết cảm nhận chi tiết của bạn về truyện (tùy chọn)..."
        android:minLines="3"
        android:gravity="top|start"
        android:background="@drawable/bg_info_rounded"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:inputType="textMultiLine"/>

</LinearLayout>