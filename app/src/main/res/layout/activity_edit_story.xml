<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="@color/background">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chỉnh sửa truyện"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            android:layout_marginBottom="16dp" />

        <!-- Tiêu đề -->
        <EditText
            android:id="@+id/et_story_title"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Tên truyện *"
            android:inputType="text"
            android:background="@color/input_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Tác giả -->
        <EditText
            android:id="@+id/et_story_author"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Tác giả *"
            android:inputType="text"
            android:background="@color/input_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Thể loại -->
        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/input_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Tên thư mục -->
        <EditText
            android:id="@+id/et_folder_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Tên thư mục (không dấu, không cách) *"
            android:inputType="text"
            android:background="@color/input_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Chọn bìa -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ảnh bìa"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="120dp"
            android:layout_height="180dp"
            android:background="@color/input_bg"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_pick_cover"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Chọn ảnh bìa"
            android:textSize="12sp"
            android:backgroundTint="@color/button_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Chọn banner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Banner"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/iv_banner"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/input_bg"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_pick_banner"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Chọn banner"
            android:textSize="12sp"
            android:backgroundTint="@color/button_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Giới thiệu -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giới thiệu truyện"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_story_description"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Nhập giới thiệu truyện..."
            android:inputType="textMultiLine"
            android:gravity="top"
            android:background="@color/input_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- Chapters -->
        <!-- Chapter Summary (shown when editing) -->
        <LinearLayout
            android:id="@+id/layout_chapter_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/input_bg"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_chapter_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có 0 chương"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_add_chapter"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="+ Thêm chương"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_button_accent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_chapter_list"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Danh sách chương"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_button_secondary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_chapters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- Nút lưu -->
        <Button
            android:id="@+id/btn_save_story"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cập nhật truyện"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>

    </ScrollView>

</LinearLayout>